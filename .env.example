# LAN runner generates and persists a random key when REMOTE_TOKEN is absent.
# Copy values into your shell environment; .env is not automatically loaded.
REMOTE_TOKEN=replace-with-a-random-key-at-least-16-characters
RELAY_PORT=8787
RELAY_HOST=0.0.0.0
RELAY_URL=ws://127.0.0.1:8787/ws
DEVICE_NAME=My Computer
# PUBLIC_HOST=192.168.0.5
# CODEX_BIN=/absolute/path/to/codex
# AGENT_DATA_DIR=/absolute/path/to/agent-data
# For direct TLS, or use deploy/compose.yml with Caddy:
# TLS_CERT=/path/to/fullchain.pem
# TLS_KEY=/path/to/privkey.pem
